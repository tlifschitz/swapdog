<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.tlifschitz.swapdog</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/.local/bin/swapdog</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>SWAPDOG_PRESSURE_LIMIT_MIN</key>
		<string>60</string>
		<key>SWAPDOG_UPTIME_DAYS</key>
		<string>14</string>
		<key>SWAPDOG_UPTIME_REPEAT_DAYS</key>
		<string>7</string>
	</dict>
	<key>StartInterval</key>
	<integer>600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.local/state/swapdog/stderr.log</string>
</dict>
</plist>
